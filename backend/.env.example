# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite Database
DATABASE_URL=sqlite+aiosqlite:///./course_illustrate.db

# LLM Configuration (Set USE_MOCK_LLM=False and provide GEMINI_API_KEY when ready)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
USE_MOCK_LLM=True

# Diffusion Image Generation Provider ("mock", "huggingface", or "stable_diffusion")
IMAGE_PROVIDER=mock
HUGGINGFACE_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
STABLE_DIFFUSION_API_URL=

# Storage
UPLOAD_DIR=./storage/uploads
GENERATED_DIR=./storage/generated
MAX_UPLOAD_SIZE_MB=25

# Application Branding
APP_NAME=CourseIllustrate AI
APP_VERSION=1.0.0
